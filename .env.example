# Get your key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Get your key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: logging/tracing controls (see rag/tracing.py)
# DEBUG, INFO, WARNING, ERROR (default: INFO)
RAG_LOG_LEVEL=
# If set, also write logs to this file path in addition to the console
RAG_LOG_FILE=

# Where every real query asked through the app gets recorded (query, retrieved
# chunks, rerank scores, answer, detected issues). Defaults to
# eval/trace_report.json if unset. Set to an empty string to disable.
RAG_TRACE_FILE=
