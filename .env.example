# Get your key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Get your key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: logging/tracing controls (see rag/tracing.py)
# DEBUG, INFO, WARNING, ERROR (default: INFO)
RAG_LOG_LEVEL=
# If set, also write logs to this file path in addition to the console
RAG_LOG_FILE=

# Where every real query asked through the app gets recorded (query, retrieved
# chunks, rerank scores, answer, detected issues). Defaults to
# eval/trace_report.json if unset. Set to an empty string to disable.
RAG_TRACE_FILE=

# Observability (see rag/observability.py): structured JSON logs, per-query
# metrics and the failure log are written under this directory (default logs/).
RAG_LOG_DIR=
# 0 disables the rotating JSON log file (console logs stay on)
RAG_JSON_LOG=
# Alert thresholds: a query slower / costlier than these gets an alert
RAG_SLOW_QUERY_MS=
RAG_QUERY_COST_WARN_USD=

# Semantic cache (see rag/semantic_cache.py). Set RAG_CACHE_ENABLED=0 to disable.
RAG_CACHE_ENABLED=
# Cosine similarity needed to serve a cached answer (default 0.92 -- keep strict)
RAG_CACHE_THRESHOLD=
RAG_CACHE_TTL_S=
RAG_CACHE_MAX_ENTRIES=
RAG_CACHE_FILE=
